# Configuration publique Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Compatibilité avec une Edge Function verify_jwt=true.
# Utiliser uniquement le JWT historique de rôle anon.
# Ne jamais intégrer une clé service_role ou sb_secret.
VITE_SUPABASE_ANON_JWT=YOUR_LEGACY_ANON_JWT
